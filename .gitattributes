* text=auto eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
# Unity's YAML serializer writes a space after empty scalar keys.
*.meta text eol=lf whitespace=-blank-at-eol
*.unity text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.ps1 text eol=crlf
*.png binary
